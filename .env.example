# Neura API Configuration
# Copy this file to .env and modify as needed

# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (with pgvector)
DATABASE_URL=postgresql://neura:neura_dev@localhost:5432/neura_db

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neura_dev_password

# JWT Authentication
JWT_SECRET=change_this_in_production

# Rate Limiting (requests per minute per tier)
RATE_LIMIT_FREE=100
RATE_LIMIT_PRO=1000
RATE_LIMIT_ENTERPRISE=5000

# Embedding Model
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Cache TTL (seconds)
CACHE_TTL_SEARCH=60
CACHE_TTL_MEMORY_LIST=30
CACHE_TTL_AUTH=300
